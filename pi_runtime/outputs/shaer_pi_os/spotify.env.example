# Spotify Developer Dashboard client ID. PKCE does not use a client secret.
SPOTIFY_CLIENT_ID=replace_with_your_client_id

# Register this exact URI in the Spotify Developer Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8775/api/spotify/callback

# Confirm the PCM5102 ALSA device with: aplay -L
SHAER_ALSA_DEVICE=hw:0,0

SHAER_CONFIG_DIR=/home/pi/.config/shaer
SHAER_CACHE_DIR=/home/pi/.cache/shaer/spotify
