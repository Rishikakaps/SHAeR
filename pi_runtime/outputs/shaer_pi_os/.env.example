# SHAeR Raspberry Pi runtime configuration.
# Copy to /etc/shaer/shaer.env during installation. Do not put secrets in Git.

# Runtime identity and paths. The bootstrap can override these with flags.
SHAER_USER=shaer
SHAER_GROUP=shaer
SHAER_INSTALL_DIR=/opt/shaer
SHAER_OUTPUTS_DIR=/opt/shaer/outputs
SHAER_CONFIG_DIR=/etc/shaer
SHAER_DATA_DIR=/var/lib/shaer
SHAER_CACHE_DIR=/var/cache/shaer
SHAER_LOG_DIR=/var/log/shaer

# Local HTTP server.
SHAER_HOST=0.0.0.0
SHAER_PORT=8775
SHAER_THEME=auto

# Mock mode is the safe first boot. Real hardware stays disabled until requested.
SHAER_MOCK_HARDWARE=1
SHAER_ENABLE_GPIO=0
SHAER_ENABLE_DISPLAY=0
SHAER_ENABLE_AUDIO=0
SHAER_ENABLE_POWER=0
SHAER_ENABLE_BLE=0
SHAER_ALLOW_TEST_INPUT=1

# GPIO pins use BCM numbering and are ignored while SHAER_ENABLE_GPIO=0.
SHAER_PIN_A=17
SHAER_PIN_B=27
SHAER_PIN_OK=22
SHAER_PIN_BACK=23
SHAER_PIN_HOME=-1

# Audio and recording defaults. Confirm real device names on the Pi before enabling audio.
SHAER_ALSA_DEVICE=hw:0,0
SHAER_MIC_DEVICE=hw:MIC,0
SHAER_RECORDINGS_DIR=/var/lib/shaer/Recordings
SHAER_RECORDINGS_DB=/var/lib/shaer/recordings.db
SHAER_RECORDING_MAX_SECONDS=3600
SHAER_RECORDING_MIN_FREE_BYTES=134217728

# Spotify uses PKCE and must not include a client secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8775/api/spotify/callback
