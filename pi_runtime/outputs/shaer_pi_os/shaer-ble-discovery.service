[Unit]
Description=SHAeR Bluetooth companion discovery
After=bluetooth.service network-online.target shaer-pi-os.service
Wants=bluetooth.service network-online.target

[Service]
Type=simple
User=shaer
EnvironmentFile=-/etc/shaer/shaer.env
ExecStart=/usr/bin/python3 /opt/shaer/outputs/shaer_pi_os/shaer_ble_discovery.py --port ${SHAER_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
