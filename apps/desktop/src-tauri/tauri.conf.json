{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHAeR Desktop Companion",
  "version": "0.1.0",
  "identifier": "in.shaer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SHAeR Desktop Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SHAeR",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Desktop companion for SHAeR devices",
    "longDescription": "Connect, pair, inspect, and manage a SHAeR device from a desktop application."
  }
}
